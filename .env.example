# Copia este archivo a .env y reemplaza los valores de ejemplo.
# Usa NOMBRE=valor sin comillas ni comentarios al final de la línea.
DJANGO_SECRET_KEY=reemplaza-por-una-clave-local-generada
DJANGO_DEBUG=1

# Base vacía y cuenta de MariaDB configuradas en tu equipo.
DB_NAME=jmhdemo
DB_USER=usuario_local_de_ejemplo
DB_PASSWORD=reemplaza-por-la-contrasena-de-tu-cuenta
DB_HOST=127.0.0.1
DB_PORT=3306
